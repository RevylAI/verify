{
  "name": "@revyl/verify",
  "version": "0.1.0",
  "description": "End-to-end tests for web and mobile apps, written in TypeScript and run on Revyl's cloud browsers and devices.",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "mobile",
    "ios",
    "android",
    "web",
    "ai",
    "revyl"
  ],
  "homepage": "https://github.com/RevylAI/verify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RevylAI/verify.git",
    "directory": "packages/verify"
  },
  "bugs": {
    "url": "https://github.com/RevylAI/verify/issues"
  },
  "license": "Apache-2.0",
  "author": "Revyl <support@revyl.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "verify": "./dist/cli/main.js",
    "revyl-verify": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && cp ../../LICENSE LICENSE && cp ../../README.md README.md"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "jiti": "^2.6.0",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
