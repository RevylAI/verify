{
  "name": "verify-workspace",
  "private": true,
  "description": "Monorepo for @revyl/verify and its examples",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspace ./packages/verify && npm rebuild --workspace ./packages/verify",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspace ./packages/verify && node --test scripts/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "package:rename": "node scripts/rename-package.mjs"
  }
}
